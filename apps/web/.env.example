# ==========================================
# SubSlash 환경 변수 설정 가이드 (Vercel 배포용)
# ==========================================

# 1. 앱 기본 도메인 (Vercel 배포 시 생성되는 도메인 또는 커스텀 도메인)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# 2. 메일함 파싱 데모 미리보기 활성화 여부 (선택사항: true / false)
NEXT_PUBLIC_SHOW_INBOX_PREVIEW="true"

# 3. 데이터베이스 (Turso Serverless SQLite - 결제일 이메일 알림 기능용, 선택사항)
# * 미설정 시에도 브라우저 LocalStorage 기반 구독 관리/체크인/대시보드는 100% 정상 작동합니다.
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# 4. 이메일 발송 (Resend - 선택사항): 결제 알림 메일과 가입 확인 메일
# * onboarding@resend.dev는 Resend 계정 주인의 주소로만 보낼 수 있습니다. 실제 사용자에게
#   보내려면 Resend에서 발신 도메인을 인증(SPF·DKIM)하고 그 도메인의 주소로 바꾸세요.
# * 미설정 시 가입은 그대로 되지만 확인 메일은 나가지 않고, 화면에 보내지 못했다고 표시됩니다.
# RESEND_API_KEY="re_123456789"
# RESEND_FROM_EMAIL="SubSlash <onboarding@resend.dev>"

# 5. Vercel Cron 및 보안 키 (선택사항)
# * EMAIL_LINK_SECRET(없으면 CRON_SECRET)은 메일 속 링크(알림 확인·수신 거부·가입 확인)에
#   서명합니다. 둘 다 없으면 확인 메일을 보내지 않습니다.
# CRON_SECRET="your-random-cron-secret-key"
# EMAIL_LINK_SECRET="your-random-email-link-secret"
