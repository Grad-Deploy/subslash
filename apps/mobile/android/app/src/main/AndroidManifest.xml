<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              인앱 브라우저에서 마친 간편 로그인·로그인 방법 연결이 앱으로 돌아오는 주소
              (`<앱 ID>://oauth-done`, apps/web/lib/app-return.ts). 스킴을 앱 ID로 두어 테스트용 앱(.dev)은
              자기 주소로 돌아온다. 주소에는 결과만 싣고 비밀값은 없다 — 세션은 앱이 쥔 verifier로만 받는다.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="oauth-done" />
            </intent-filter>

        </activity>

        <!--
          카카오톡이 없거나 카카오톡 로그인이 안 되면 SDK가 카카오계정 로그인을 인앱 브라우저로 열고, 끝나면
          kakao<네이티브 앱 키>://oauth 로 이 화면에 돌아온다(KakaoLoginPlugin). 키는 gradle.properties에 있다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="oauth" android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 로컬 알림 플러그인이 넣는 정확한 알람 권한을 뺀다. 결제일 알림은 몇 분 늦어도 되고
         (apps/web/lib/native-reminders), 이 권한은 안드로이드 14부터 사용자가 따로 켜야 하며
         스토어에서도 쓰는 이유를 요구한다. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!-- 사용 정보 접근(PACKAGE_USAGE_STATS). 앱이 요청 창을 띄울 수 없는 특별 권한이라, 무엇을 재는지
         먼저 보여 준 뒤 사용자가 기기 설정에서 직접 허용한다. UsageStatsPlugin 하나가 두 기능에 쓴다.
         - 폰 사용 기록: 읽은 기록은 기기 안에서만 쓴다(apps/web/lib/usage).
         - 여러 기기 사용 측정: 사용자가 따로 켜면 로그인한 계정에 올린다
           (apps/web/lib/device-usage, 설정의 '여러 기기 사용 측정').
         이 권한을 넣은 빌드를 스토어에 올리기 전에 Play Console의 데이터 보안 항목과 권한 신고서를 고친다. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- 사용 기록을 재는 서비스 앱이 설치됐는지 확인하려면 안드로이드 11부터 여기에 적어야 한다.
         apps/web/lib/usage/packages.ts의 연결표와 같아야 한다(테스트가 맞춰 본다). -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="net.cj.cjhv.gs.tving" />
        <package android:name="kr.co.captv.pooqV2" />
        <package android:name="com.frograms.wplay" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="laftel.net.laftel" />
        <package android:name="com.spotify.music" />
        <package android:name="com.iloen.melon" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.naver.vibe" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="notion.id" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
        <package android:name="ai.perplexity.app.android" />
        <package android:name="kr.co.millie.millieshelf" />
        <package android:name="com.initialcoms.ridi" />
        <!-- 구독 중인지 묻는 데에만 쓴다(SUGGEST_ONLY_PACKAGES). -->
        <package android:name="com.coupang.mobile.play" />
        <!-- 해지 경로가 앱 안에 있는 서비스(services.ts의 cancelAndroidApp). 해지 버튼이 이 앱을 연다. -->
        <package android:name="com.sampleapp" />
        <package android:name="com.coupang.mobile" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.nhn.android.ndrive" />
    </queries>
</manifest>
