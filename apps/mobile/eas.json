{
  "cli": {
    "version": ">= 24.4.2",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.1",
      "pnpm": "9.12.0",
      "env": {
        "NEXT_PUBLIC_WEB_ORIGIN": "https://www.subslash.me",
        "NEXT_PUBLIC_STORAGE_QUOTA_WEB_APP_URL": "https://script.google.com/macros/s/AKfycbwttL0VNzhAAu0rv7GqriFPS3h1d_YvLujFqWJ1UjBe6lg_AyTMg8YCv54vlZGCXguoPA/exec"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "ios": {
        "image": "latest",
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    },
    "closed-test": {
      "extends": "production",
      "env": {
        "NEXT_PUBLIC_WEB_ORIGIN": "https://www.subslash.me",
        "NEXT_PUBLIC_STORAGE_QUOTA_WEB_APP_URL": "https://script.google.com/macros/s/AKfycbwttL0VNzhAAu0rv7GqriFPS3h1d_YvLujFqWJ1UjBe6lg_AyTMg8YCv54vlZGCXguoPA/exec",
        "NEXT_PUBLIC_STATS_SAMPLE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
