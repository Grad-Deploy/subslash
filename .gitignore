# Dependencies
node_modules/

# Build outputs
.next/
dist/
out/

# Turbo
.turbo/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
coverage/
playwright-report/
test-results/

# Local database (dev fallback when TURSO_DATABASE_URL is unset)
local.db
local.db-*
*.sqlite
*.sqlite3

# Misc
*.log
*.tsbuildinfo

.vercel

# vercel CLI가 받아오는 .env.local에는 OIDC 토큰이 들어간다.
# .env.example은 문서라서 예외로 둔다.
.env*
!.env.example

# EAS Build(apps/mobile/eas.json)는 저장소 루트의 .gitignore만 읽고 하위 폴더의 .gitignore는 읽지 않는다.
# 아래는 apps/mobile/android의 .gitignore가 이미 무시하는 것인데, 루트에도 적어야 EAS가 올리지 않는다.
# 빠뜨리면 로컬 빌드 산출물(디버그 APK 등)이 올라가 EAS 결과물에 섞인다. 웹 화면과 플러그인 폴더는
# 작업 서버에서 훅이 다시 만든다(apps/mobile/scripts/eas-build-post-install.sh).
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/local.properties
apps/mobile/android/capacitor-cordova-android-plugins/
apps/mobile/android/app/src/main/assets/public/
apps/mobile/android/app/src/main/assets/capacitor.config.json
apps/mobile/android/app/src/main/assets/capacitor.plugins.json
apps/mobile/android/app/src/main/res/xml/config.xml

# 작업 메모(피드백 정리, 계획서)는 어느 레포에도 올리지 않는다.
# Grad-Deploy 미러는 히스토리에서도 *.pdf·*.txt를 한 번 더 거른다(.github/workflows/mirror.yml).
*.pdf
*.txt
/implementation_plan*.md
/subslash_analysis.md
