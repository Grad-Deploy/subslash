# SubSlash 환경 변수 설정
# 이 파일을 복사하여 .env.local로 저장하세요
#
# 구독 데이터는 브라우저 localStorage가 원본입니다. 아래 설정은 "결제 임박
# 이메일 알림"을 켠 사용자에 한해 동작하는 서버 미러용입니다.

# ── Turso (libSQL) Database ──
# 비워두면 로컬 SQLite 파일(file:local.db)을 사용합니다. 개발 시에는 그대로 두어도
# 무방하며, 배포 시에만 Turso 값을 채우면 됩니다.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ── Resend Email ──
# 비워두면 메일을 보내지 않고 서버 로그에만 출력합니다(알림 흐름 로컬 테스트용).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SubSlash <noreply@subslash.app>"

# ── Vercel Cron ──
# /api/cron/notify 호출 인증에 사용합니다. 설정되지 않으면 크론은 실행을 거부합니다.
CRON_SECRET="your-cron-secret-key"

# ── 이메일 링크 서명 ──
# 확인/수신거부 링크 서명 키. 비워두면 CRON_SECRET을 사용합니다.
EMAIL_LINK_SECRET=""

# ── App Config ──
# 이메일 본문의 링크가 이 주소를 기준으로 생성됩니다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
